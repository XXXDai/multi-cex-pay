# multi-cex-pay 环境变量示例
#
#   cp .env.example .env
#
# 然后按需修改 .env。**.env 永远不要提交到 git**（已在 .gitignore 里），
# 它会包含 ADMIN_TOKEN / WEBHOOK_SECRET / MASTER_KEY 以及交易所 API 凭据。
# 本文件里所有值都是占位或默认值，没有任何真实密钥。
#
# 每一项都可以整行删掉或留空 —— 留空等于用默认值。
# 下面括号里写的就是代码里的默认值（见 cexpay/config.py）。

# ---------------------------------------------------------------------------
# 服务与存储
# ---------------------------------------------------------------------------
# 数据目录：SQLite 库、credentials.json、收款码原图都放这里（默认 data）
CEXPAY_DATA_DIR=data
# 监听地址。默认只听本机；要对外提供服务请放到 Nginx/Caddy 后面做 HTTPS（默认 127.0.0.1）
CEXPAY_HOST=127.0.0.1
# 监听端口（默认 8787）
CEXPAY_PORT=8787
# 日志级别：DEBUG / INFO / WARNING / ERROR（默认 INFO）
CEXPAY_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# 鉴权与加密
# ---------------------------------------------------------------------------
# 管理后台（/admin 与 /api/admin/*）的 Bearer Token。留空则管理接口不可用。
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(32))"
CEXPAY_ADMIN_TOKEN=
# 凭据文件的加密口令。设置后 credentials.json 用 Fernet 加密存储，
# 需要额外安装 cryptography（pip install "multi-cex-pay[crypto]"）。
# 一旦丢失该口令，已存的凭据无法解密，只能重新录入。
CEXPAY_MASTER_KEY=
# 回调签名密钥，用于 X-CexPay-Signature 的 HMAC-SHA256。留空则不签名（不推荐）。
# 生成方式同 ADMIN_TOKEN。
CEXPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# 订单与轮询
# ---------------------------------------------------------------------------
# 订单默认有效期，秒（默认 1800）
CEXPAY_ORDER_TTL=1800
# 后台轮询交易所的间隔，秒；设为 0 表示不启动轮询线程，
# 只在用户点"我已付款"或调用 /api/admin/sweep 时才拉取（默认 20）
CEXPAY_POLL_INTERVAL=20
# 是否给每笔订单分配唯一金额（T1 核销的基础，强烈建议开启）（默认 true）
CEXPAY_UNIQUE_AMOUNT=true
# 唯一金额的小数位数：4 位小数 => 同一价位可并发 9999 笔订单（默认 4）
CEXPAY_UNIQUE_AMOUNT_DECIMALS=4
# 调交易所接口的超时，秒（默认 15）
CEXPAY_HTTP_TIMEOUT=15
# 启动/测试凭据时是否强制要求 API Key 为只读，检测到提币或交易权限就拒绝（默认 true）
CEXPAY_ENFORCE_READONLY=true

# ---------------------------------------------------------------------------
# 核销策略（cexpay/matching.py 里各档匹配都会用到）
# ---------------------------------------------------------------------------
# 只接受这个币种的入账（默认 USDT）
CEXPAY_CURRENCY=USDT
# 允许少付的额度；少付超过它一律不核销（默认 0.02）
CEXPAY_AMOUNT_TOLERANCE=0.02
# 允许多付的上限，避免把大额充值误配到小额订单上（默认 5）
CEXPAY_MAX_OVERPAY=5
# 允许入账时间早于订单创建时间的秒数，用于"先付款后下单"（默认 1800）
CEXPAY_WINDOW_BEFORE=1800
# 允许入账时间晚于订单过期时间的秒数（默认 3600）
CEXPAY_WINDOW_AFTER=3600
# 是否必须由用户提交付款方标识才允许核销；
# 关掉后仅靠"唯一金额 + 时间窗"即可自动核销（默认 false）
CEXPAY_REQUIRE_IDENTIFIER=false
# Binance 付款方昵称的模糊匹配阈值，0~1；昵称被打码成 Ming***Li 所以不能要求全等（默认 0.6）
CEXPAY_NAME_SIMILARITY=0.6
# 唯一金额被占用后的冷却时间，秒；防止用户晚付导致串单（默认 86400）
CEXPAY_AMOUNT_COOLDOWN=86400
# 是否启用备注码匹配（目前只有 Binance Pay 的转账备注能读到）（默认 true）
CEXPAY_ENABLE_MEMO=true
# 备注码位数（默认 6）
CEXPAY_MEMO_LENGTH=6

# ---------------------------------------------------------------------------
# 交易所凭据 —— 必须使用只读 API Key，不要开提币/交易权限，建议绑定服务器 IP
# ---------------------------------------------------------------------------
# 也可以不写在这里，改用管理后台录入（写进 data/credentials.json，权限 0600）。
# 环境变量优先级高于凭据文件。三家交易所只配其中一家也能跑。

# Binance：需要 API Key + Secret（无 passphrase）
CEXPAY_BINANCE_API_KEY=
CEXPAY_BINANCE_API_SECRET=
# 收银台上展示的收款账号说明，例如 Pay ID 后四位；纯展示，可留空
CEXPAY_BINANCE_ACCOUNT_LABEL=

# OKX：需要 API Key + Secret + Passphrase
CEXPAY_OKX_API_KEY=
CEXPAY_OKX_API_SECRET=
CEXPAY_OKX_PASSPHRASE=
CEXPAY_OKX_ACCOUNT_LABEL=

# Bitget：需要 API Key + Secret + Passphrase
CEXPAY_BITGET_API_KEY=
CEXPAY_BITGET_API_SECRET=
CEXPAY_BITGET_PASSPHRASE=
CEXPAY_BITGET_ACCOUNT_LABEL=
